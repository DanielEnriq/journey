# Vowe cloud API (server/). On DigitalOcean these are app-level env vars (see .do/app.yaml);
# locally, export them or run: node --env-file=../.env dist/index.js. Never commit values.

PORT=8080

# Supabase: verifies callers' sessions and checks room membership under their RLS.
# The publishable key only; the API never needs the secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# LiveKit: POST /livekit/token. cloud.livekit.io → Settings → API Keys.
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs: POST /elevenlabs/signed-url.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
