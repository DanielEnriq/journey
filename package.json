{
  "name": "journey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p . && node scripts/copy-renderer-assets.mjs",
    "start": "pnpm build && electron .",
    "preview:ui": "pnpm build && electron dist/main/preview.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -p . --noEmit",
    "test:calls": "pnpm build && pnpm api:build && node scripts/call-e2e/run.mjs",
    "eval:agent": "pnpm build && node scripts/agent-eval/run.mjs",
    "canvas:validate": "node scripts/agent-eval/validate-command.mjs",
    "test": "tsc -p . && node scripts/copy-renderer-assets.mjs && node --test \"dist/**/*.test.js\"",
    "db:generate": "drizzle-kit generate",
    "cloud:push": "supabase db push --linked",
    "cloud:types": "supabase gen types typescript --linked --schema public > src/integrations/supabase/types.ts",
    "cloud:functions": "supabase functions deploy livekit-token",
    "sign-out": "pnpm build && electron . --sign-out",
    "api:build": "pnpm --filter vowe-api build",
    "api:start": "pnpm --filter vowe-api build && node --env-file-if-exists=.env server/dist/index.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "supabase"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "^11.3.1",
    "livekit-client": "2.22.4",
    "preact": "10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "0.31.11",
    "electron": "^45.0.0",
    "supabase": "2.122.0",
    "typescript": "^7.0.2"
  }
}
